# =====================================================================
# Variables de entorno de ejemplo — Sistema COPRODA
# Copiar a src/backend/.env (backend) y a src/backend/agente/.env (agente)
# y reemplazar los valores. NUNCA subir el archivo .env real.
# =====================================================================

# --- Backend (Flask) — src/backend ---
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/coproda
SECRET_KEY=cambia_esta_clave_secreta

# --- Frontend (React + Vite) — src/frontend ---
# La URL de la API se define en src/frontend/src/config/api.jsx
# Local: http://localhost:5000/coproda

# --- Agente conversacional — src/backend/agente ---
# suscripcion = sesión de Claude Code (`claude auth login`); api = Messages API con ANTHROPIC_API_KEY
AGENTE_BACKEND=suscripcion
ANTHROPIC_API_KEY=tu_api_key_aqui
AGENTE_MODELO=claude-opus-5
AGENTE_MAX_TOKENS=16000
AGENTE_EFFORT=
COPRODA_API_URL=http://localhost:5000/coproda
COPRODA_API_TIMEOUT=20
COPRODA_CACHE_TTL=60
AGENTE_MAX_ITERACIONES=6
AGENTE_DEBUG=0

# --- WhatsApp Cloud API (opcional, pruebas) ---
WA_PHONE_NUMBER_ID=tu_phone_number_id
WA_TOKEN=tu_token_de_whatsapp
WA_VERIFY_TOKEN=tu_verify_token
WA_APP_SECRET=tu_app_secret
WA_NUMEROS_PERMITIDOS=50200000000
WA_PORT=8000
